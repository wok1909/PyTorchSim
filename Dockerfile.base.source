# syntax=docker/dockerfile:1.4
ARG PYTORCH_IMAGE=pytorch/pytorch:2.8.0-cuda12.8-cudnn9-devel
FROM ${PYTORCH_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      git \
      m4 \
      scons \
      zlib1g \
      zlib1g-dev \
      libprotobuf-dev \
      protobuf-compiler \
      libprotoc-dev \
      libgoogle-perftools-dev \
      python3-dev \
      python-is-python3 \
      libboost-all-dev \
      libhdf5-serial-dev \
      python3-pydot \
      libpng-dev \
      libelf-dev \
      pkg-config \
      python3-pip \
      python3-venv \
      black \
      libssl-dev \
      libubsan1 \
      curl \
      device-tree-compiler \
      wget \
      ninja-build \
      ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir -U pip setuptools wheel && \
    python -m pip install --no-cache-dir \
      onnx \
      matplotlib \
      scikit-learn \
      pydot \
      tabulate \
      "transformers<4.44" \
      diffusers==0.34.0 \
      ultralytics \
      opencv-python-headless \
      pandas \
      seaborn && \
    python -m pip install --no-cache-dir --user \
      conan==1.56.0 \
      cmake==3.26.4

ARG INSTALL_FLASH_ATTN=0
RUN if [[ "${INSTALL_FLASH_ATTN}" == "1" ]]; then \
      python -m pip install --no-build-isolation --no-cache-dir flash-attn; \
    fi

ENV RISCV=/workspace/riscv
ENV PATH=/root/.local/bin:${RISCV}/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:/opt/conda/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64:${LD_LIBRARY_PATH}
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}

# Download prebuilt RISC-V toolchains used by spike + riscv-pk.
RUN wget -q https://github.com/riscv-collab/riscv-gnu-toolchain/releases/download/2023.12.14/riscv64-glibc-ubuntu-22.04-llvm-nightly-2023.12.14-nightly.tar.gz -O /tmp/riscv64-glibc.tar.gz && \
    wget -q https://github.com/riscv-collab/riscv-gnu-toolchain/releases/download/2023.12.14/riscv64-elf-ubuntu-20.04-llvm-nightly-2023.12.14-nightly.tar.gz -O /tmp/riscv64-elf.tar.gz && \
    mkdir -p /workspace && \
    tar -xzf /tmp/riscv64-glibc.tar.gz -C /workspace && \
    tar -xzf /tmp/riscv64-elf.tar.gz -C /workspace && \
    rm -f /tmp/riscv64-glibc.tar.gz /tmp/riscv64-elf.tar.gz

# Build gem5 from source.
RUN git clone --depth 1 https://github.com/PSAL-POSTECH/gem5.git /workspace/gem5 && \
    cd /workspace/gem5 && \
    scons build/RISCV/gem5.opt -j"$(nproc)"
ENV GEM5_PATH=/workspace/gem5/build/RISCV/gem5.opt

# Build LLVM (mlir + riscv target) from source.
ARG LLVM_BRANCH=torchsim
RUN git clone --depth 1 --branch ${LLVM_BRANCH} https://github.com/PSAL-POSTECH/llvm-project.git /workspace/llvm-project && \
    cmake -S /workspace/llvm-project/llvm -B /workspace/llvm-project/build \
      -G Ninja \
      -DLLVM_ENABLE_PROJECTS=mlir \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/riscv-llvm \
      -DLLVM_TARGETS_TO_BUILD=RISCV && \
    cmake --build /workspace/llvm-project/build --parallel "$(nproc)" && \
    cmake --install /workspace/llvm-project/build
ENV TORCHSIM_LLVM_PATH=/riscv-llvm/bin
ENV TORCHSIM_DIR=/workspace/PyTorchSim
ENV PATH=${TORCHSIM_LLVM_PATH}:${PATH}

# Build Spike from source.
ARG SPIKE_BRANCH=TorchSim
RUN git clone --depth 1 --branch ${SPIKE_BRANCH} https://github.com/PSAL-POSTECH/riscv-isa-sim.git /workspace/riscv-isa-sim && \
    mkdir -p /workspace/riscv-isa-sim/build && \
    cd /workspace/riscv-isa-sim/build && \
    ../configure --prefix=${RISCV} && \
    make -j"$(nproc)" && \
    make install

# Build and install RISC-V proxy kernel.
RUN git clone https://github.com/riscv-software-src/riscv-pk.git /workspace/riscv-pk && \
    cd /workspace/riscv-pk && \
    git checkout 4f3debe4d04f56d31089c1c716a27e2d5245e9a1 && \
    mkdir -p build && \
    cd build && \
    ../configure --prefix=${RISCV} --host=riscv64-unknown-elf && \
    make -j"$(nproc)" && \
    make install

ENV C_INCLUDE_PATH=${RISCV}/include:${C_INCLUDE_PATH}
